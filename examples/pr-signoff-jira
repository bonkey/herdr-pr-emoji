#!/usr/bin/env python3
# A sign-off hook that reads the state of a review ticket in Jira.
#
#   signoffCommand = "/path/to/examples/pr-signoff-jira"
#
# Every open, undrafted pull request arrives on stdin as
#   owner/name<TAB>branch<TAB>number<TAB>reviewDecision<TAB>mergeStateStatus
# and the answer is
#   owner/name<TAB>branch<TAB>not_required|missing|open|done
#
# The lookup runs ticket to pull request, not the other way round: a ticket
# that names a pull request in its description is the only link there is, so one
# search fetches every candidate ticket and the pull requests are matched
# against what those tickets name. One request a cycle, whatever the sidebar
# holds, and no fuzzy search on a bare pull request number.
#
# Everything specific to your team is an environment variable. Nothing about it
# belongs in this file.
#
#   SIGNOFF_JIRA_URL        https://your-team.atlassian.net
#   SIGNOFF_JIRA_JQL        the search for candidate tickets, for example
#                           project = ABC AND summary ~ "\"[PR Review]\""
#                           AND updated >= -30d
#   SIGNOFF_JIRA_EMAIL      the account the token belongs to
#   SIGNOFF_JIRA_TOKEN      an API token, or
#   SIGNOFF_JIRA_TOKEN_CMD  a command that prints one, to keep it out of the
#                           environment: "op read op://Private/jira/token"
#   SIGNOFF_JIRA_PAGES      how many pages of 100 tickets to read. Default: 3
#   SIGNOFF_REVIEW_CHECK    a regular expression, matched case-insensitively
#                           against the names of the required checks that have
#                           yet to pass. One that matches means a review is
#                           wanted. Default: review
#
# Every failure exits non-zero with a line on stderr, which the daemon logs.
# Each row then keeps the glyph it has until its TTL runs out.
#
# `curl` makes the request rather than urllib: it reads the system trust store,
# which is what a corporate proxy's certificate is installed in, and it honours
# the HTTPS_PROXY environment. The credentials go to its stdin as a config
# file, so no secret is ever an argument another process could read.

import base64
import json
import os
import re
import subprocess
import sys
import urllib.parse

PULL_URL = re.compile(r"github\.com[:/]+([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)/pull/(\d+)")
REVIEW_CHECK = re.compile(os.environ.get("SIGNOFF_REVIEW_CHECK") or "review", re.I)
PAGE = 100
TIMEOUT = 15


def fail(message):
    sys.stderr.write("pr-signoff-jira: %s\n" % message)
    raise SystemExit(1)


def setting(name, required=True):
    value = (os.environ.get(name) or "").strip()
    if required and not value:
        fail("%s is not set" % name)
    return value


def token():
    """The API token, from the environment or from a command that prints it."""
    command = setting("SIGNOFF_JIRA_TOKEN_CMD", required=False)
    if not command:
        return setting("SIGNOFF_JIRA_TOKEN")
    try:
        done = subprocess.run(
            command,
            shell=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError) as error:
        fail("SIGNOFF_JIRA_TOKEN_CMD: %s" % error)
    if done.returncode != 0:
        fail(
            "SIGNOFF_JIRA_TOKEN_CMD exited %d: %s"
            % (done.returncode, done.stderr.decode("utf-8", "replace").strip())
        )
    value = done.stdout.decode("utf-8", "replace").strip()
    if not value:
        fail("SIGNOFF_JIRA_TOKEN_CMD printed nothing")
    return value


def get_json(url, auth):
    """The JSON at `url`, fetched by curl with the credentials on its stdin.

    A `--config` file is how curl takes a header without it becoming an
    argument: an argument is readable by anybody who can list processes.
    """
    config = 'url = "%s"\nheader = "Authorization: Basic %s"\nheader = "Accept: application/json"\n' % (
        url,
        auth,
    )
    try:
        done = subprocess.run(
            ["curl", "--silent", "--show-error", "--fail-with-body", "--config", "-"],
            input=config.encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError) as error:
        fail("curl: %s" % error)
    if done.returncode != 0:
        detail = done.stdout.decode("utf-8", "replace").strip() or done.stderr.decode(
            "utf-8", "replace"
        ).strip()
        fail("curl exited %d: %s" % (done.returncode, detail.splitlines()[:1] or ""))
    try:
        body = json.loads(done.stdout.decode("utf-8", "replace"))
    except ValueError:
        detail = done.stdout.decode("utf-8", "replace").strip().splitlines()
        fail("%s answered no JSON: %s" % (url.split("/rest/")[0], detail[:1] or ""))
    if not isinstance(body, dict):
        fail("%s answered no object" % url.split("/rest/")[0])
    return body


def search(base, jql, auth, pages):
    """Every candidate ticket, as (description, status category) pairs.

    `/rest/api/3/search/jql` is the only search Jira Cloud still answers, and
    it pages by a cursor rather than by an offset: the token of the last answer
    asks for the next page, and its absence means there was no next page.

    It returns the description as an Atlassian document tree, so the pair
    carries that tree serialised back to JSON rather than any text. A pull
    request URL in it is either the text of a paragraph or the target of a
    link, and both are strings in the tree — which is all `tickets_by_pull`
    needs, because it reads the description with a regular expression.
    """
    found, token = [], ""
    for _ in range(pages):
        query = {"jql": jql, "fields": "status,description", "maxResults": PAGE}
        if token:
            query["nextPageToken"] = token
        body = get_json(
            "%s/rest/api/3/search/jql?%s"
            % (base.rstrip("/"), urllib.parse.urlencode(query)),
            auth,
        )
        if body.get("errorMessages") or body.get("errors"):
            fail(
                "%s: %s"
                % (
                    base,
                    "; ".join(body.get("errorMessages") or [])
                    or json.dumps(body.get("errors")),
                )
            )
        for issue in body.get("issues") or []:
            fields = issue.get("fields") or {}
            category = ((fields.get("status") or {}).get("statusCategory") or {}).get(
                "key"
            )
            found.append((json.dumps(fields.get("description") or ""), category or ""))
        token = body.get("nextPageToken") or ""
        if not token:
            break
    return found


def tickets_by_pull(issues):
    """{(slug, number): state} for every pull request the tickets name.

    `statusCategory` rather than a status name, so no list of your team's
    workflow states has to live here: Jira puts every finished status in the
    `done` category whatever it is called. A pull request named by more than one
    ticket counts as signed off once any of them is finished.
    """
    states = {}
    for description, category in issues:
        state = "done" if category == "done" else "open"
        for slug, number in PULL_URL.findall(description):
            key = (slug.lower(), int(number))
            if states.get(key) != "done":
                states[key] = state
    return states


def unsatisfied_checks(column):
    """[(name, result)] from the `name=RESULT;name=RESULT` column."""
    found = []
    for part in column.split(";"):
        if not part.strip():
            continue
        name, _, result = part.partition("=")
        found.append((name.strip(), result.strip()))
    return found


def without_a_ticket(review, merge, unsatisfied):
    """What a pull request no ticket names reads as.

    This is the part to adapt. A review is wanted here when GitHub says nobody
    has approved the pull request, and also when a required check whose name
    matches SIGNOFF_REVIEW_CHECK has yet to pass — `reviewDecision` alone
    cannot see that gate, because a review bot's approval turns it APPROVED
    while the check still stands at ACTION_REQUIRED.
    """
    if review == "REVIEW_REQUIRED":
        return "missing"
    if any(REVIEW_CHECK.search(name) for name, _ in unsatisfied):
        return "missing"
    return "not_required"


def main():
    rows = []
    for line in sys.stdin:
        parts = line.rstrip("\n").split("\t")
        if len(parts) < 3 or not parts[0] or not parts[1]:
            continue
        try:
            number = int(parts[2])
        except ValueError:
            continue
        rows.append(
            (
                parts[0],
                parts[1],
                number,
                parts[3] if len(parts) > 3 else "",
                parts[4] if len(parts) > 4 else "",
                unsatisfied_checks(parts[5] if len(parts) > 5 else ""),
            )
        )
    if not rows:
        return 0

    base = setting("SIGNOFF_JIRA_URL")
    jql = setting("SIGNOFF_JIRA_JQL")
    email = setting("SIGNOFF_JIRA_EMAIL")
    try:
        pages = max(1, int(setting("SIGNOFF_JIRA_PAGES", required=False) or 3))
    except ValueError:
        pages = 3
    auth = base64.b64encode(("%s:%s" % (email, token())).encode("utf-8")).decode("ascii")

    # The identity is asked for first, because a search Jira does not recognise
    # the caller of answers 200 with an empty list rather than refusing: every
    # pull request would then read as one no ticket names, which is a wrong
    # answer where an error is the true one.
    who = get_json("%s/rest/api/3/myself" % base.rstrip("/"), auth)
    if not who.get("accountId"):
        fail("%s does not recognise %s" % (base, email))

    states = tickets_by_pull(search(base, jql, auth, pages))
    for slug, branch, number, review, merge, unsatisfied in rows:
        state = states.get((slug.lower(), number)) or without_a_ticket(
            review, merge, unsatisfied
        )
        sys.stdout.write("%s\t%s\t%s\n" % (slug, branch, state))
    return 0


if __name__ == "__main__":
    sys.exit(main())
